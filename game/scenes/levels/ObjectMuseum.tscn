[node name="Story31" type="Label3D" parent="PuzzleRooms/Scales"]
transform = Transform3D(0, 0, 1, 0, 1, 0, -1, 0, 0, -106.8, 3.4, 7)
double_sided = false
pixel_size = 0.006
font_size = 28
outline_size = 4
horizontal_alignment = 0
autowrap_mode = 3
width = 1833.33333
text = "The floor is a 20 m deck balanced on a hinge (it tips up to 10 degrees either way). The counterweight sled holds it down on the right; every ballast shot that lands on the left tips it back, and a tipped deck sends the shot rolling off whichever end is low, which tips it again.\n\nPUZZLE: keep the deck level enough to run a line across it. Your own machines, items in transit and even you weigh on it. Load both sides together, shift the sled, or build the rolling on purpose into a timer.\nNEW: ballast shot, counterweight sled, tilt gauge. The deck, sled and hinge really move; the sled isn't motorised yet."

