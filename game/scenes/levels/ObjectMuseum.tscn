[node name="Story29" type="Label3D" parent="PuzzleRooms/Tumbler"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -63.5, 5.5, -27)
billboard = 1
pixel_size = 0.006
font_size = 28
outline_size = 4
horizontal_alignment = 0
autowrap_mode = 3
width = 1500
text = "The whole room turns a quarter turn about its long axis, pauses, and turns again: floor becomes wall becomes ceiling. Everything built inside turns with it, so only magnetic belts keep their loads, and the path from the spawner to the deposit box has to work in every orientation (or use the turns on purpose: tip a load from one belt run onto another).\n\nWalk in from the bridge and drop through the hub. Whenever the room stops, a doorway in the near end sits at floor level over the exit landing. The structures and items here are a frozen tableau; the room and its colliders really turn."

