config_version=5

[application]

config/name="GMPFramework"
run/main_scene="uid://ckre0b3bwrbof"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Global="*uid://b4engl1rluqqq"
ImGuiRoot="*uid://dugmpnsxaagba"
LimboConsole="*uid://dyxornv8vwibg"
GameWorld="*uid://diwgca4ea4mq8"
Lobby="*uid://dfuapltpe6pga"
RpcManager="*uid://cisvc3rton0m"
Console="*uid://dle03qiwu8337"
BuildGrid="*res://game/core/BuildGrid.cs"

[display]

