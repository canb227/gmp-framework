<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
     <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="gmp\core\entities\**" />
    <Compile Remove="gmp\example\**" />
    <EmbeddedResource Remove="gmp\core\entities\**" />
    <EmbeddedResource Remove="gmp\example\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ENet-CSharp" Version="2.4.8" />
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
    <PackageReference Include="LimboConsole.Sharp" Version="0.0.1-beta-010" />
    <PackageReference Include="LiteNetLib" Version="2.1.4" />
    <PackageReference Include="Nerdbank.MessagePack" Version="1.3.85" />
    <PackageReference Include="Nerdbank.MessagePack.Godot" Version="1.3.85" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Steamworks.NET">
      <HintPath>lib\windows\Steamworks.NET.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>