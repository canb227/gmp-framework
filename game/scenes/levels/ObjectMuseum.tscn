double_sided = false
text = "ROOM 6: THE TAR PIT"
font_size = 96

[node name="Story34" type="Label3D" parent="PuzzleRooms/TarPit" unique_id=652344119]
transform = Transform3D(0, 0, 1, 0, 1, 0, -1, 0, 0, -105.8, 3.4, 44)
pixel_size = 0.006
double_sided = false
text = "STICKY CHAIN (after Gleba's spoilage clock and Corrundum's clinging chemistry).
Tar blobs are STICKY: they grip belts, so they won't drop off a belt end without a scraper; they glue to walls and to each other, so they clump into plugs in chutes; and they cure into worthless tar rock within a couple of minutes, so buffering them is waste. Chilling (the cryo vent) pauses both. Tumbling them with chalk in the coating drum rolls them into dry, free-rolling coated pellets, which a press turns into grippy bitumen bricks.

PUZZLE: scrape, drop and tumble the blobs with the right chalk ratio before they cure or jam. Cold storage buys time, and the high-friction tar floor slows anything crossing it.
NEW: tar blob, chalk nodule, coated pellet, tar rock, bitumen brick, belt scraper, coating drum."
font_size = 28
outline_size = 4
horizontal_alignment = 0
autowrap_mode = 3
width = 1833.3334

